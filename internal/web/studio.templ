package web

import (
	"encoding/json"
	"math"
	"strconv"
	"strings"

	"github.com/sruckh/timbre/internal/jobs"
	"github.com/sruckh/timbre/internal/voices"
)

// Studio is the primary view: the masthead, the compose card (script editor +
// parameters), the voice library, the render queue and the playback spoken
// line — the whole product on one page, per DESIGN.md and index.html.
templ Studio(items []jobs.Job, vs []voices.Voice, durations map[int64]string, selected int64) {
	{{ take := resolveSelected(items, selected) }}
	{{ sourceTake, _ := takeByID(items, take) }}
	@AppShell("Studio · Timbre", "studio") {
		<header class="pb-12">
			@spectrum()
			<h1 class="font-display text-[clamp(32px,5vw,44px)] font-extrabold leading-none tracking-[-0.04em]">
				Say it in your <em class="not-italic text-olive">voice</em>.
			</h1>
			<p class="mt-3 max-w-[56ch] text-text-dim">
				Paste a script, pick a voice, and render speech on the rack. The queue below
				polls itself — nothing on this page waits on the GPU.
			</p>
		</header>
		@Compose(vs, firstVoiceID(vs), sourceTake)
		<section class="mt-12 border-t border-line pt-12" id="voices">
			<p class="eyebrow">Voice library</p>
			<h2 class="font-display text-[26px] font-semibold tracking-[-0.02em]">A voice is a card</h2>
			<p class="mt-2 max-w-[62ch] text-text-dim">
				Stock models ship commercial-safe. Upload a short, clean reference to clone a
				voice — it is stored privately and delivered to the synthesizer inline.
				The whole card is the target.
			</p>
			<div class="mt-5">
				@uploadAffordance()
			</div>
			<div class="mt-4">
				@VoiceGrid(vs, firstVoiceID(vs))
			</div>
		</section>
		<section class="mt-12 border-t border-line pt-12" id="queue-sec">
			<p class="eyebrow">Render queue</p>
			<h2 class="font-display text-[26px] font-semibold tracking-[-0.02em]">What the GPU is doing</h2>
			<p class="mt-2 max-w-[62ch] text-text-dim">
				Serverless endpoints sleep. The queue is honest about that: warming is a state
				of its own, not a disguised spinner, and every row shows what it cost.
				Pick a row to hear it.
			</p>
			<div class="mt-6 scrollable-list max-h-[500px]">
				@Queue(items, 0, durations, take)
			</div>
		</section>
		@playbackSection(items, durations, take)
		@studioHelpers(take)
	}
}

// resolveSelected decides which take the player shows. An explicit selection
// (the row the user clicked, echoed back by the queue's poll) wins as long as
// the take still exists; otherwise the most recent ready take is the sensible
// default, which is what the studio showed before rows were selectable.
func resolveSelected(items []jobs.Job, selected int64) int64 {
	if selected > 0 {
		for _, j := range items {
			if j.ID == selected {
				return selected
			}
		}
	}
	if j, ok := latestReady(items); ok {
		return j.ID
	}
	return 0
}

// takeByID returns the job with the given id.
func takeByID(items []jobs.Job, id int64) (jobs.Job, bool) {
	for _, j := range items {
		if j.ID == id {
			return j, true
		}
	}
	return jobs.Job{}, false
}

// sourceTakeInit seeds the compose form from the ready take already selected in
// the player. Later queue-row selections update the same Alpine state by event.
func sourceTakeInit(j jobs.Job) string {
	if j.Status != jobs.StatusReady || j.ID <= 0 || strings.TrimSpace(j.AudioPath) == "" {
		return ""
	}
	id := strconv.FormatInt(j.ID, 10)
	return "sourceTakeID = '" + id + "'; sourceTakeLabel = 'Take " + id + "'; sourceTakeReady = true"
}

// Compose is the render form. AuK gets a dedicated task workspace because its
// generation, editing, enhancement and separation contract is not a conventional
// text-plus-voice TTS form.
templ Compose(available []voices.Voice, selectedID int64, sourceTake jobs.Job) {
	<form
		hx-post="/jobs"
		hx-target="#queue"
		hx-swap="outerHTML"
		enctype="multipart/form-data"
		class="flex flex-col gap-6 rounded-container border border-line bg-surface-1 p-6"
		x-data="{ script: '', aukInstruction: '', pace: '1', pitch: '0', expr: '0.65', limit: 5000, engine: '', mode: 'clone', aukTask: 'instruct_tts', aukVariant: 'flash', nfe: '4', aukCfg: '0', audioSource: 'upload', sourceTakeID: '', sourceTakeLabel: 'No ready render selected', sourceTakeReady: false, get isBreeze() { return this.engine === $refs.breezeModel.value }, get isAuK() { return this.engine === $refs.aukModel.value }, get needsInstruct() { return this.isBreeze &amp;&amp; (this.mode === 'design' || this.mode === 'direction') }, get aukNeedsSource() { return ['content_edit','acoustic_edit','paralinguistic_edit','enhancement','separation'].includes(this.aukTask) }, get aukAllowsPrompt() { return this.aukTask === 'zero_shot_tts' || this.aukTask === 'auto' }, get needsVoice() { return (!this.isAuK &amp;&amp; (!this.isBreeze || this.mode !== 'design')) || (this.isAuK &amp;&amp; this.aukAllowsPrompt) }, get aukSourceMissing() { return this.isAuK &amp;&amp; this.aukNeedsSource &amp;&amp; this.audioSource === 'render' &amp;&amp; !this.sourceTakeReady }, setAuKDefaults() { if (this.aukVariant === 'base') { this.nfe = '32'; this.aukCfg = '2'; } else { this.nfe = '4'; this.aukCfg = '0'; } }, tag(t) { this.script = this.script + t }, get chars() { return [...this.script].length }, get over() { return this.chars > this.limit }, get est() { var s = this.chars / (15 * (parseFloat(this.pace) || 1)); var m = Math.floor(s / 60); return m + ':' + String(Math.round(s % 60)).padStart(2, '0') } }"
		x-init={ sourceTakeInit(sourceTake) }
		x-on:timbre-source-selected.window="sourceTakeID = String($event.detail.id); sourceTakeLabel = $event.detail.label; sourceTakeReady = Boolean($event.detail.ready); if (!sourceTakeReady &amp;&amp; audioSource === 'render') audioSource = 'upload'"
		x-on:timbre-assistant-apply.window="aukInstruction = $event.detail.instruction; if ($event.detail.task) { aukTask = $event.detail.task }"
	>
		<input type="hidden" id="voice_id" name="voice_id" value={ strconv.FormatInt(selectedID, 10) } x-bind:disabled="!needsVoice"/>
		<div class="grid gap-6 sm:grid-cols-2">
			<div>
				<label class="field-label" for="model">Engine</label>
				<select class="input focus:ring-2 focus:ring-indigo" id="model" name="model" aria-label="Speech engine" x-model="engine">
					<option value={ jobs.DefaultModel } selected>MOSS-TTS v1.5</option>
					<option value={ jobs.HiggsModel }>Higgs TTS 3.4B</option>
					<option x-ref="breezeModel" value={ jobs.BreezeModel }>Breeze TTS 2</option>
					<option x-ref="aukModel" value={ jobs.AuKModel }>Tencent AuK</option>
				</select>
				<p class="help" x-show="!isAuK">MOSS is the default. Higgs uses cloned references. Breeze adds clone, design and direction modes.</p>
				<p class="help" x-show="isAuK" x-cloak>AuK is an audio Swiss knife: generate, clone, edit, enhance or separate audio through one queued workflow.</p>
			</div>
			<div x-show="isBreeze" x-cloak>
				<label class="field-label" for="mode">Breeze mode</label>
				<select class="input focus:ring-2 focus:ring-indigo" id="mode" name="mode" aria-label="Breeze synthesis mode" x-model="mode" x-bind:disabled="!isBreeze">
					<option value="clone">Clone — copy a reference voice</option>
					<option value="design">Design — build a voice from a description</option>
					<option value="direction">Direction — clone, then steer the delivery</option>
				</select>
				<p class="help" x-text="mode === 'design' ? 'Design needs no reference voice — the description is the voice.' : 'Uses the selected voice and its stored reference transcript.'"></p>
			</div>
		</div>
		<div x-show="!isAuK">
			<label class="field-label" for="script">Script</label>
			<textarea id="script" name="text" rows="6" required x-bind:disabled="isAuK" x-model="script" x-ref="scriptBox" :style="over ? 'border-color: var(--color-burnt)' : ''" placeholder="Paste the script to render…" class="input script-input"></textarea>
			<div class="count">
				<span x-text="chars.toLocaleString() + ' / ' + limit.toLocaleString() + ' characters'">0 / 5,000 characters</span>
				<span x-text="'≈ ' + est + ' at current pace'">≈ 0:00 at current pace</span>
			</div>
			<div class="meter"><i :style="'width:' + Math.min(100, (chars / limit) * 100) + '%'"></i></div>
			<p class="help help--limit" x-show="over" x-cloak>Past the 5,000-character limit. Split the script into two takes and render them in sequence.</p>
		</div>
		<section x-show="isAuK" x-cloak class="grid gap-6 rounded-card border border-line bg-surface-2 p-5 sm:grid-cols-2" aria-label="Tencent AuK task controls">
			<div class="sm:col-span-2">
				<p class="eyebrow">AuK task</p>
				<label class="field-label" for="auk_instruction">Instruction</label>
				<textarea class="input script-input" id="auk_instruction" name="instruction" rows="4" x-model="aukInstruction" x-bind:disabled="!isAuK" x-bind:required="isAuK" placeholder="Describe exactly what AuK should generate, change, enhance or extract."></textarea>
				<p class="help">AuK has no separate text field. Include the words to speak and the desired voice or edit in this instruction.</p>
			</div>
			<div class="sm:col-span-2 rounded-card border border-line bg-surface-1 p-3" x-data="aukAssistant()">
				<button type="button" class="btn btn--quiet btn--sm" @click="open = !open" :aria-expanded="open.toString()">
					<span x-text="open ? 'Hide AI prompt assistant' : 'Ask the AI prompt assistant'"></span>
				</button>
				<div x-show="open" x-cloak class="mt-3 flex flex-col gap-3">
					<p class="help">Describes what you want in plain language; the assistant answers with an AuK-aligned instruction. It never overwrites your instruction on its own — use "Insert into instruction" on a reply. It is text-only and never sees your actual audio: for a task needing a reference or source clip, ignore its request for an attachment and instead select the right voice card or source above — Timbre supplies the real audio separately.</p>
					<div class="flex flex-col gap-2 max-h-[280px] overflow-y-auto" aria-live="polite">
						<template x-for="(m, i) in messages" :key="i">
							<div class="rounded-card border border-line p-2" :class="m.role === 'user' ? 'bg-surface-2' : 'bg-surface-1'">
								<p class="text-[11px] font-mono text-text-faint" x-text="m.role === 'user' ? 'You' : 'Assistant'"></p>
								<p class="whitespace-pre-wrap text-[13.5px]" x-text="m.content"></p>
								<button type="button" class="btn btn--quiet btn--sm mt-1" x-show="m.instruction" x-cloak @click="apply(m.instruction, m.task)">Insert into instruction</button>
								<p class="help" x-show="m.instruction &amp;&amp; !m.task" x-cloak>Also set the matching Mode above — it could not be inferred automatically.</p>
							</div>
						</template>
					</div>
					<p class="help" x-show="error" x-cloak x-text="error"></p>
					<textarea class="input" rows="2" x-model="draft" placeholder="e.g. make the narrator sound calmer and a little slower" x-bind:disabled="busy" @keydown.enter.prevent="send()"></textarea>
					<div class="flex flex-wrap items-center gap-2">
						<button type="button" class="btn btn--sm" @click="send()" x-bind:disabled="busy || !draft.trim()" x-text="busy ? 'Asking…' : 'Ask assistant'"></button>
						<button type="button" class="btn btn--quiet btn--sm" @click="clear()" x-show="messages.length" x-cloak>Clear conversation</button>
					</div>
				</div>
			</div>
			<div>
				<label class="field-label" for="auk_task">Mode</label>
				<select class="input focus:ring-2 focus:ring-indigo" id="auk_task" name="task" x-model="aukTask" x-bind:disabled="!isAuK">
					<option value="auto">Auto — infer generation from prompt presence</option>
					<option value="zero_shot_tts">Zero-shot TTS — clone a prompt voice</option>
					<option value="instruct_tts">Instruction TTS — design and speak</option>
					<option value="content_edit">Content editing — replace, insert or delete</option>
					<option value="acoustic_edit">Acoustic editing — pitch, speed or volume</option>
					<option value="paralinguistic_edit">Paralinguistic editing — emotion, timbre and cues</option>
					<option value="enhancement">Enhancement — denoise or dereverb</option>
					<option value="separation">Separation — isolate a source or speaker</option>
				</select>
				<p class="help" x-text="aukNeedsSource ? 'Choose an upload or the selected ready render as source audio.' : (aukAllowsPrompt ? 'Uses the selected cloned voice card when a reference is needed.' : 'This task takes the instruction alone.')"></p>
			</div>
			<div>
				<label class="field-label" for="model_variant">Model variant</label>
				<select class="input focus:ring-2 focus:ring-indigo" id="model_variant" name="model_variant" x-model="aukVariant" x-on:change="setAuKDefaults()" x-bind:disabled="!isAuK">
					<option value="flash">Flash — fixed four-step distilled model</option>
					<option value="base">Base — configurable flow-matching model</option>
				</select>
				<p class="help">Flash is the fast default. Base trades more diffusion steps for control.</p>
			</div>
			<div x-show="aukNeedsSource" x-cloak class="sm:col-span-2">
				<span class="field-label">Source audio</span>
				<div class="flex flex-wrap gap-6 pt-1" role="radiogroup" aria-label="AuK source audio">
					<label class="sw-toggle">
						<input type="radio" name="audio_source" value="upload" x-model="audioSource" x-bind:disabled="!isAuK || !aukNeedsSource"/>
						<span class="track"><span class="knob"></span></span><span class="text-[13.5px]">Upload audio</span>
					</label>
					<label class="sw-toggle">
						<input type="radio" name="audio_source" value="render" x-model="audioSource" x-bind:disabled="!isAuK || !aukNeedsSource || !sourceTakeReady"/>
						<span class="track"><span class="knob"></span></span><span class="text-[13.5px]">Use selected render</span>
					</label>
				</div>
				<p class="help" x-text="sourceTakeReady ? sourceTakeLabel + ' is available from the render queue.' : 'Select a ready take in the render queue to use it here.'"></p>
			</div>
			<div x-show="aukNeedsSource &amp;&amp; audioSource === 'upload'" x-cloak class="sm:col-span-2">
				<label class="field-label" for="audio_file">Source audio upload</label>
				<input class="input" id="audio_file" name="audio_file" type="file" accept="audio/*" x-bind:disabled="!isAuK || !aukNeedsSource || audioSource !== 'upload'" x-bind:required="isAuK &amp;&amp; aukNeedsSource &amp;&amp; audioSource === 'upload'"/>
				<p class="help">Private, decoded limit 15 MB. Kept only until the queued job is submitted.</p>
			</div>
			<input type="hidden" name="source_job_id" x-model="sourceTakeID" x-bind:disabled="!isAuK || !aukNeedsSource || audioSource !== 'render' || !sourceTakeReady"/>
			<div x-show="aukAllowsPrompt" x-cloak class="sm:col-span-2">
				<p class="field-label">Reference voice</p>
				<p class="help">Zero-shot TTS uses the selected cloned voice card and its stored reference audio. Auto uses that reference when the selected card is a clone; stock cards leave Auto in instruction mode.</p>
			</div>
			<div x-show="aukAllowsPrompt" x-cloak class="sm:col-span-2">
				<label class="field-label" for="prompt_text">Reference transcript override</label>
				<textarea class="input" id="prompt_text" name="prompt_text" rows="2" x-bind:disabled="!isAuK || !aukAllowsPrompt" placeholder="Optional; otherwise Timbre uses the selected voice card's stored transcript."></textarea>
			</div>
			<div>
				<label class="field-label" for="gen_seconds">Generation seconds</label>
				<input class="input" id="gen_seconds" name="gen_seconds" type="number" min="0.5" max="300" step="0.1" x-bind:disabled="!isAuK" placeholder="Automatic"/>
				<p class="help">Optional hard duration, from 0.5 to 300 seconds.</p>
			</div>
			<div>
				<label class="field-label" for="gen_text">Duration text hint</label>
				<input class="input" id="gen_text" name="gen_text" type="text" x-bind:disabled="!isAuK" placeholder="Text used by AuK's duration heuristic"/>
				<p class="help">Optional; useful when the instruction contains prose around the words to speak.</p>
			</div>
			<div>
				<label class="field-label" for="nfe">Diffusion steps (NFE)</label>
				<input class="input" id="nfe" name="nfe" type="number" x-model="nfe" x-bind:min="aukVariant === 'base' ? 16 : 1" x-bind:max="aukVariant === 'base' ? 64 : 8" x-bind:disabled="!isAuK"/>
				<p class="help" x-text="aukVariant === 'base' ? 'Base accepts 16–64; default 32.' : 'Flash accepts 1–8 but always executes four steps.'"></p>
			</div>
			<div>
				<label class="field-label" for="auk_cfg_scale">Guidance (CFG)</label>
				<input class="input" id="auk_cfg_scale" name="cfg_scale" type="number" step="0.1" x-model="aukCfg" x-bind:min="aukVariant === 'base' ? 1 : 0" x-bind:max="aukVariant === 'base' ? 5 : 0" x-bind:readonly="aukVariant === 'flash'" x-bind:disabled="!isAuK"/>
				<p class="help" x-text="aukVariant === 'base' ? 'Base accepts 1.0–5.0; default 2.0.' : 'Flash always uses CFG 0.0.'"></p>
			</div>
			<div class="sm:col-span-2">
				<label class="field-label" for="response_delivery">Audio delivery</label>
				<select class="input focus:ring-2 focus:ring-indigo" id="response_delivery" name="response_delivery" x-bind:disabled="!isAuK">
					<option value="auto">Auto — prefer presigned S3 when configured</option>
					<option value="s3">S3 — require presigned delivery</option>
					<option value="base64">Base64 — inline short audio</option>
				</select>
				<p class="help">Timbre downloads either result into your private local queue so playback outlives an expiring URL.</p>
			</div>
		</section>
		<div class="grid gap-6 sm:grid-cols-2">
			<div x-show="needsInstruct" x-cloak class="sm:col-span-2">
				<label class="field-label" for="instruct">Voice instruction</label>
				<textarea class="input" id="instruct" name="instruct" rows="2" aria-label="Natural-language voice instruction" x-bind:disabled="!needsInstruct" placeholder="A warm, unhurried narrator with a low voice and a dry wit."></textarea>
				<p class="help">Describes the voice for design, or how to steer the cloned speaker for direction.</p>
			</div>
			<div x-show="isBreeze" x-cloak>
				<label class="field-label" for="cfg_scale">Guidance (cfg_scale)</label>
				<input class="input" id="cfg_scale" name="cfg_scale" value="4" inputmode="decimal" aria-label="Guidance scale" x-bind:disabled="!isBreeze"/>
				<p class="help">The Breeze worker's default is 4.</p>
			</div>
			<div x-show="isBreeze" x-cloak class="sm:col-span-2">
				<span class="field-label">Vocal events</span>
				<div class="flex flex-wrap gap-2">
					for _, cue := range []string{ "(laugh)", "(sigh)", "(cough)", "(clears throat)" } {
						<button type="button" class="btn btn-ghost" aria-label={ "Insert " + cue } x-on:click={ "tag(' " + cue + " ')" }>{ cue }</button>
					}
				</div>
				<p class="help">Inserted into the script as-is. Your text is never rewritten.</p>
			</div>
			<div>
				<label class="field-label" for="seed">Seed</label>
				<input class="input" id="seed" name="seed" value="184203" inputmode="numeric"/>
				<p class="help">Reuse a seed to reproduce a take exactly.</p>
			</div>
			<div x-show="!isAuK">
				<div class="range-head"><label class="field-label" for="pace" style="margin:0">Pace</label><span class="range-val" x-text="(+pace).toFixed(2) + '×'">1.00×</span></div>
				<input class="range" type="range" id="pace" name="pace" min="0.5" max="2" step="0.05" value="1" x-model="pace" x-bind:disabled="isAuK" x-init="rangeFill($el)" @input="rangeFill($el)"/>
			</div>
			<div x-show="!isAuK">
				<div class="range-head"><label class="field-label" for="pitch" style="margin:0">Pitch</label><span class="range-val" x-text="(+pitch > 0 ? '+' : '') + pitch + ' st'">0 st</span></div>
				<input class="range" type="range" id="pitch" name="pitch" min="-12" max="12" step="1" value="0" x-model="pitch" x-bind:disabled="isAuK" x-init="rangeFill($el)" @input="rangeFill($el)"/>
			</div>
			<div x-show="!isAuK">
				<div class="range-head"><label class="field-label" for="expr" style="margin:0">Expressiveness</label><span class="range-val" x-text="(+expr).toFixed(2)">0.65</span></div>
				<input class="range" type="range" id="expr" name="expressiveness" min="0" max="1" step="0.01" value="0.65" x-model="expr" x-bind:disabled="isAuK" x-init="rangeFill($el)" @input="rangeFill($el)"/>
			</div>
			<div x-show="!isAuK">
				<span class="field-label">Output</span>
				<div class="flex flex-wrap gap-6 pt-1">
					<label class="sw-toggle"><input type="checkbox" name="output_48k" checked x-bind:disabled="isAuK"/><span class="track"><span class="knob"></span></span><span class="text-[13.5px]">48 kHz WAV</span></label>
					<label class="sw-toggle"><input type="checkbox" name="normalize" x-bind:disabled="isAuK"/><span class="track"><span class="knob"></span></span><span class="text-[13.5px]">Normalize</span></label>
				</div>
			</div>
		</div>
		<div class="flex flex-wrap items-center gap-3">
			<button type="submit" class="btn" x-bind:disabled="aukSourceMissing" x-text="isAuK ? 'Run AuK task' : 'Render speech'">Render speech</button>
			<button type="button" class="btn btn--quiet" x-show="!isAuK &amp;&amp; chars > 0" x-cloak @click="script = ''; $refs.scriptBox.focus()">Clear script</button>
			<button type="reset" class="btn btn--quiet" @click="script = ''; aukInstruction = ''; aukTask = 'instruct_tts'; aukVariant = 'flash'; audioSource = 'upload'; setAuKDefaults()">Reset controls</button>
		</div>
	</form>
}

// spectrum is the masthead's ambient level meter: the palette itself as ten
// bars, breathing at 3.2s — animation two of the three the system allows, and
// the one place pure Blue may appear.
templ spectrum() {
	<div class="spectrum" aria-hidden="true">
		for i, b := range spectrumBars() {
			<i class={ b.class } style={ "height: " + b.height + "%; animation-delay: " + strconv.FormatFloat(float64(i)*0.16, 'f', 2, 64) + "s" }></i>
		}
	</div>
}

type spectrumBar struct {
	class  string
	height string
}

// spectrumBars is the palette in palette order, at the living reference's
// heights. Ink on Ink reads as a rest — the meter is decorative, not data.
func spectrumBars() []spectrumBar {
	return []spectrumBar{
		{"bg-blue", "46"},
		{"bg-purple", "62"},
		{"bg-burnt", "80"},
		{"bg-teal", "58"},
		{"bg-olive", "100"},
		{"bg-amber", "72"},
		{"bg-green", "54"},
		{"bg-paper", "88"},
		{"bg-indigo", "66"},
		{"bg-ink", "40"},
	}
}

// latestReady returns the most recent ready job (items are newest-first),
// which is the take the spoken line plays.
func latestReady(items []jobs.Job) (jobs.Job, bool) {
	for _, j := range items {
		if j.Status == jobs.StatusReady {
			return j, true
		}
	}
	return jobs.Job{}, false
}

// scriptWords splits a take's text for the spoken line's word-level playhead.
func scriptWords(text string) []string {
	return strings.Fields(text)
}

// timedWord is one word with its real start/end seconds, captured by the
// serverless worker's forced alignment. When alignment is present the spoken
// line is rendered from these: the model normalizes text before synthesis
// (numbers expanded, punctuation reflowed, pinyin rewritten), so W is what was
// actually said — not the caller's input.
type timedWord struct {
	W     string  `json:"w"`
	Start float64 `json:"start"`
	End   float64 `json:"end"`
}

// alignmentWords decodes a job's stored word_timings block into its timed
// words. An empty or malformed block yields nil, which the caller treats as
// "no alignment — interpolate": bad data must never wedge the player.
func alignmentWords(alignmentJSON string) []timedWord {
	s := strings.TrimSpace(alignmentJSON)
	if s == "" {
		return nil
	}
	var payload struct {
		Words []timedWord `json:"words"`
	}
	if err := json.Unmarshal([]byte(s), &payload); err != nil {
		return nil
	}
	return payload.Words
}

// waveHeights returns n deterministic bar heights (px) for the spoken line's
// waveform — the living reference's envelope, computed server-side so the
// markup is stable.
func waveHeights(n int) []float64 {
	out := make([]float64, n)
	for i := range out {
		env := math.Sin((float64(i) / float64(n)) * math.Pi)
		out[i] = 6 + (math.Abs(math.Sin(float64(i)*1.7))*0.6+math.Abs(math.Sin(float64(i)*0.43))*0.4)*42*(0.35+env*0.65)
	}
	return out
}

// playbackSection renders the signature component for the selected take. Its
// inner div is the swap target for GET /jobs/{id}/player and nothing else: the
// queue's two-second poll never touches it, so a take keeps playing while the
// table around it refreshes.
templ playbackSection(items []jobs.Job, durations map[int64]string, selected int64) {
	<section class="mt-12 border-t border-line pt-12" id="playback">
		<p class="eyebrow">Playback</p>
		<h2 class="font-display text-[26px] font-semibold tracking-[-0.02em]">The spoken line</h2>
		<p class="mt-2 max-w-[62ch] text-text-dim">
			Waveform and script are one instrument: the played portion turns Teal, the word
			being spoken sits in Olive, and everything already said settles to dim Paper.
		</p>
		<div class="mt-6" id="playback-body">
			if j, ok := takeByID(items, selected); ok {
				@PlayerBody(j, durations[j.ID])
			} else {
				@PlayerBody(jobs.Job{}, "")
			}
		</div>
	</section>
}

// PlayerBody is the playback fragment for one take — the studio's initial
// paint and the answer to GET /jobs/{id}/player. A ready take gets the spoken
// line; a take still on the rack says so rather than showing dead transport
// controls; the zero job is the empty state.
templ PlayerBody(j jobs.Job, dur string) {
	if j.ID == 0 {
		<div class="empty">
			<span class="badge badge--live"><span class="dot"></span> Nothing rendered yet</span>
			<h4>Nothing to play yet</h4>
			<p>Render a take and it lands here — waveform, words and all, ready to hear and download.</p>
		</div>
	} else if j.Status == jobs.StatusReady {
		@spokenLinePlayer(j, dur)
	} else if j.Status == jobs.StatusFailed {
		<div class="alert alert--limit" role="status">
			<div>
				<b>Take { strconv.FormatInt(j.ID, 10) } failed</b>
				<p>
					if j.Error != "" {
						{ j.Error }
					} else {
						The render did not finish.
					}
					{ " " }
					Queue it again, or pick another take from the queue.
				</p>
			</div>
		</div>
	} else {
		<div class="alert alert--working" role="status">
			<div>
				<b>Take { strconv.FormatInt(j.ID, 10) } — { statusLabel(j.Status) }</b>
				<p>It lands here the moment it is ready — the queue is watching for you.</p>
			</div>
		</div>
	}
}

// spokenLinePlayer is the signature component wired to the take's real audio:
// an <audio> element drives the playhead through the waveform and the words.
templ spokenLinePlayer(j jobs.Job, dur string) {
	<div class="player" x-data="spokenLine()">
		<div class="player-bar">
			<button type="button" class="play" @click="toggle" :aria-label="playing ? 'Pause preview' : 'Play preview'">
				<svg x-show="!playing" width="15" height="15" viewBox="0 0 15 15" fill="currentColor" aria-hidden="true"><path d="M3 2l10 5.5L3 13z"></path></svg>
				<svg x-show="playing" x-cloak width="15" height="15" viewBox="0 0 15 15" fill="currentColor" aria-hidden="true"><rect x="3" y="2.5" width="3.5" height="10"></rect><rect x="8.5" y="2.5" width="3.5" height="10"></rect></svg>
			</button>
			<div class="wave" x-ref="wave" aria-hidden="true">
				for _, h := range waveHeights(84) {
					<i style={ "height: " + strconv.FormatFloat(h, 'f', 1, 64) + "px" }></i>
				}
			</div>
			<span class="time" x-text="timeLabel">{ "0:00 / " + dur }</span>
		</div>
		<p class="script" x-ref="script">
			{{
				words := alignmentWords(j.AlignmentJSON)
				fallback := scriptWords(j.Text)
			}}
			if len(words) > 0 {
				for _, w := range words {
					<span class="wd" data-t0={ strconv.FormatFloat(w.Start, 'f', 3, 64) } data-t1={ strconv.FormatFloat(w.End, 'f', 3, 64) }>{ w.W }</span>{ " " }
				}
			} else {
				for _, w := range fallback {
					<span class="wd">{ w }</span>{ " " }
				}
			}
		</p>
		<div class="player-foot">
			<div class="flex flex-wrap items-center gap-3">
				<span class="badge badge--ready"><span class="dot"></span> Ready</span>
				if j.VoiceKind == voices.KindCloned {
					<span class="badge badge--cloned">Cloned voice</span>
				}
				if j.Model != "" {
					<span class="badge badge--info">{ j.Model }</span>
				}
				<span class="font-mono text-[13px] tabular-nums text-text-faint">{ dur } · take { strconv.FormatInt(j.ID, 10) }</span>
			</div>
			<div class="flex flex-wrap items-center gap-2">
				<a class="btn btn--quiet btn--sm" href={ templ.SafeURL("/jobs/" + strconv.FormatInt(j.ID, 10) + "/audio") } download>Download WAV</a>
			</div>
		</div>
		<audio
			x-ref="audio"
			src={ "/jobs/" + strconv.FormatInt(j.ID, 10) + "/audio" }
			preload="metadata"
			class="hidden"
			@timeupdate="paint"
			@ended="finish"
			@loadedmetadata="paint"
			@pause="playing = false; paint()"
		></audio>
	</div>
}

// studioHelpers is the small client-side script the studio and queue pages
// share: slider fill binding, voice-card selection sync, queue-row selection,
// the reference-preview component and the spoken line's Alpine component
// factory. Defined once per page, before Alpine boots.
//
// selected seeds the take the queue reports back on each poll. It is written
// once per page load, never from the queue fragment: a fragment that reset it
// could overwrite a click the user made while the request was in flight.
templ studioHelpers(selected int64) {
	<script type="text/javascript" data-take={ strconv.FormatInt(selected, 10) }>
		if (window.timbreTake === undefined) {
			window.timbreTake = parseInt(document.currentScript.dataset.take, 10) || 0;
		}
		function rangeFill(el) {
			var pct = (el.value - el.min) / (el.max - el.min) * 100;
			el.style.setProperty('--fill', pct + '%');
		}
		// Select a voice card: flip aria-pressed (the CSS restyles) and sync the
		// compose form's hidden voice. The card's own controls (rename, preview)
		// stop propagation, so using them never changes the selection.
		function timbreSelectVoice(card) {
			var grid = card.closest('#voice-grid');
			if (!grid) { return; }
			grid.querySelectorAll('.voice-card').forEach(function (b) {
				b.setAttribute('aria-pressed', 'false');
			});
			card.setAttribute('aria-pressed', 'true');
			var vid = document.getElementById('voice_id');
			if (vid && card.dataset.voiceId) { vid.value = card.dataset.voiceId; }
		}
		// Select a queue row: remember the take and mark it immediately, rather
		// than waiting for the fragment HTMX is already fetching.
		function timbreSelectTake(row) {
			window.timbreTake = parseInt(row.dataset.take, 10) || 0;
			timbrePaintTake();
			window.dispatchEvent(new CustomEvent('timbre-source-selected', {
				detail: {
					id: row.dataset.take,
					label: 'Take ' + row.dataset.take,
					ready: row.dataset.sourceReady === 'true'
				}
			}));
		}
		// Re-assert the selection over whatever markup is currently in the DOM.
		// The server renders the highlight and the poll URL carries the take, so
		// this normally agrees with what just arrived — but a swap answering a
		// delete or an enqueue has no take in its URL, and without this the
		// highlight would blink off for a tick. It also points the next poll at
		// the right URL straight after a click.
		function timbrePaintTake() {
			var queue = document.getElementById('queue');
			if (!queue) { return; }
			var take = window.timbreTake || 0;
			queue.setAttribute('hx-get', take > 0 ? '/jobs/queue?take=' + take : '/jobs/queue');
			queue.querySelectorAll('.queue-row').forEach(function (r) {
				var on = take > 0 && parseInt(r.dataset.take, 10) === take;
				r.classList.toggle('is-selected', on);
				r.setAttribute('aria-selected', on ? 'true' : 'false');
			});
		}
		// htmx 4 renamed afterSwap/afterSettle to htmx:after:swap.
		document.addEventListener('htmx:after:swap', timbrePaintTake);
		timbrePaintTake();
		// Delegated to document so both survive a fragment swap.
		document.addEventListener('click', function (e) {
			var card = e.target.closest('.voice-card');
			if (card) { timbreSelectVoice(card); return; }
			var row = e.target.closest('.queue-row');
			if (row) { timbreSelectTake(row); }
		});
		document.addEventListener('keyup', function (e) {
			if (e.key !== 'Enter' && e.key !== ' ') { return; }
			if (!e.target.closest) { return; }
			var card = e.target.closest('.voice-card');
			if (card) { timbreSelectVoice(card); return; }
			var row = e.target.closest('.queue-row');
			if (row) { timbreSelectTake(row); }
		});
		// Space on a focused card or row scrolls the page by default.
		document.addEventListener('keydown', function (e) {
			if (e.key !== ' ' || !e.target.closest) { return; }
			if (e.target.closest('.voice-card') || e.target.closest('.queue-row')) {
				e.preventDefault();
			}
		});
		// The reference preview on a cloned voice card: one <audio> per card,
		// pausing every other one so two clips never play at once.
		window.voicePreview = function () {
			return {
				playing: false,
				toggle: function () {
					var a = this.$refs.ref;
					if (!a) { return; }
					if (this.playing) { a.pause(); return; }
					document.querySelectorAll('audio[data-ref-preview]').forEach(function (other) {
						if (other !== a) { other.pause(); }
					});
					var self = this;
					a.play().then(function () { self.playing = true; }, function () {});
				}
			};
		};
		// The AuK prompt assistant: a small chat loop against POST
		// /jobs/auk-assistant. Conversation state is Alpine-only (never
		// persisted) and a structured reply only ever reaches the instruction
		// field through the explicit "Insert into instruction" button — never
		// automatically, so a clarifying question can't silently overwrite text
		// the user is mid-edit on.
		window.aukAssistant = function () {
			return {
				open: false,
				messages: [],
				draft: '',
				busy: false,
				error: '',
				// Pulls the quoted INSTRUCTION out of the assistant's fixed
				// TASK/INSTRUCTION/REQUIRED AUDIO INPUT/NOTES block, if present.
				// A plain clarifying question has no such block and parses to null.
				parseInstruction: function (text) {
					// The instruction itself often quotes a target phrase
					// (e.g. say: "[target text]"), and an LLM does not
					// reliably escape that inner quote against the outer
					// INSTRUCTION: "..." wrapper — sometimes it backslash-
					// escapes it, sometimes it leaves it bare, producing
					// unbalanced quote counts a character-class regex cannot
					// tell apart from the real closing quote. So don't hunt
					// for a "matching" quote at all: the fixed output format
					// is line-based, so the INSTRUCTION value is bounded by
					// the next field label (or the closing code fence, or
					// end of text) regardless of what punctuation it
					// contains. Only the outermost quote pair — if the whole
					// captured span happens to be wrapped in one — is ever
					// stripped; anything quoted inside that span is left
					// exactly as written.
					var m = /INSTRUCTION:\s*([\s\S]*?)(?:\r?\n\s*(?:TASK|REQUIRED AUDIO INPUT|NOTES)\s*:|```|$)/.exec(text);
					if (!m) { return null; }
					var value = m[1].trim();
					if (!value) { return null; }
					var wrapped = /^["'\u201c\u2018]([\s\S]*)["'\u201d\u2019]$/.exec(value);
					if (wrapped) { value = wrapped[1]; }
					return value.replace(/\\(["\\nrt])/g, function (whole, ch) {
						return { '"': '"', '\\': '\\', n: '\n', r: '\r', t: '\t' }[ch];
					});
				},
				// Maps the assistant's free-text "TASK: <family> — <sub-task>"
				// line onto one of AuK's 8 worker task codes, using the exact
				// family/sub-task vocabulary its own system prompt instructs it
				// to use. Returns null on anything that doesn't match a known
				// term rather than guessing wrong — a mismatched Mode is worse
				// than an unset one (e.g. inserting a "using the reference
				// voice provided" instruction under instruct_tts sends no
				// reference audio to AuK at all).
				parseTask: function (text) {
					var m = /TASK:\s*(.+)/.exec(text);
					if (!m) { return null; }
					var line = m[1].toLowerCase();
					if (line.indexOf('zero-shot') >= 0 || line.indexOf('zero shot') >= 0) { return 'zero_shot_tts'; }
					if (line.indexOf('instruct') >= 0) { return 'instruct_tts'; }
					if (line.indexOf('lyric') >= 0 || line.indexOf('content edit') >= 0) { return 'content_edit'; }
					if (line.indexOf('acoustic') >= 0 || line.indexOf('speaking rate') >= 0 || line.indexOf('pitch') >= 0 || line.indexOf('loudness') >= 0) { return 'acoustic_edit'; }
					if (line.indexOf('paralinguistic') >= 0 || line.indexOf('emotion') >= 0 || line.indexOf('timbre') >= 0 || line.indexOf('accent') >= 0 || line.indexOf('whisper') >= 0 || line.indexOf('nonverbal') >= 0) { return 'paralinguistic_edit'; }
					if (line.indexOf('separat') >= 0) { return 'separation'; }
					if (line.indexOf('enhance') >= 0 || line.indexOf('denois') >= 0 || line.indexOf('dereverb') >= 0 || line.indexOf('resolution') >= 0 || line.indexOf('restor') >= 0) { return 'enhancement'; }
					return null;
				},
				send: function () {
					var text = this.draft.trim();
					if (!text || this.busy) { return; }
					this.error = '';
					this.messages.push({ role: 'user', content: text });
					this.draft = '';
					this.busy = true;
					var self = this;
					var payload = { messages: this.messages.map(function (m) { return { role: m.role, content: m.content }; }) };
					fetch('/jobs/auk-assistant', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
						body: JSON.stringify(payload)
					}).then(function (res) {
						if (!res.ok) {
							return res.text().then(function (body) { throw new Error(body || ('status ' + res.status)); });
						}
						return res.json();
					}).then(function (data) {
						var instruction = self.parseInstruction(data.reply);
						self.messages.push({ role: 'assistant', content: data.reply, instruction: instruction, task: instruction ? self.parseTask(data.reply) : null });
					}).catch(function (err) {
						self.error = 'The assistant could not answer: ' + err.message;
					}).finally(function () {
						self.busy = false;
					});
				},
				apply: function (instruction, task) {
					window.dispatchEvent(new CustomEvent('timbre-assistant-apply', { detail: { instruction: instruction, task: task || null } }));
				},
				clear: function () {
					this.messages = [];
					this.error = '';
				}
			};
		};
		// The spoken line: an Alpine component painting the playhead through
		// waveform bars (Teal past / Olive now) and words (settled dim, current
		// Ink-on-Olive) from the audio element's clock.
		window.spokenLine = function () {
			return {
				playing: false,
				timeLabel: '',
				fmt: function (s) {
					if (!isFinite(s) || s <= 0) { return '0:00'; }
					var m = Math.floor(s / 60);
					return m + ':' + String(Math.floor(s % 60)).padStart(2, '0');
				},
				init: function () { this.paint(); },
				toggle: function () {
					var a = this.$refs.audio;
					if (!a) { return; }
					if (this.playing) { a.pause(); this.playing = false; this.paint(); return; }
					var self = this;
					a.play().then(function () { self.playing = true; self.paint(); }, function () {});
				},
				finish: function () { this.playing = false; this.paint(); },
				paint: function () {
					var a = this.$refs.audio;
					if (!a) { return; }
					var d = a.duration || 0;
					var t = a.currentTime || 0;
					var p = d > 0 ? t / d : 0;
					var bars = this.$refs.wave.children;
					var edge = Math.floor(p * bars.length);
					for (var i = 0; i < bars.length; i++) {
						bars[i].className = i < edge ? 'past' : (i === edge && this.playing ? 'now' : '');
					}
					var words = this.$refs.script.querySelectorAll('.wd');
					// Real timing when the server emitted data-t0/data-t1; the
					// current word is the last whose start is at or before the
					// playhead. Otherwise fall back to proportional interpolation
					// across the words by audio position.
					var timed = words.length > 0 && words[0].dataset.t0 !== undefined;
					var wi;
					if (timed) {
						wi = -1;
						for (var k = 0; k < words.length; k++) {
							if (t < parseFloat(words[k].dataset.t0)) { break; }
							wi = k;
						}
					} else {
						wi = Math.floor(p * words.length);
					}
					for (var j = 0; j < words.length; j++) {
						words[j].className = j < wi ? 'wd said' : (j === wi && this.playing ? 'wd now' : 'wd');
					}
					this.timeLabel = this.fmt(t) + ' / ' + this.fmt(d);
				}
			};
		};
	</script>
}
