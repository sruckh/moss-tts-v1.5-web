package web

import (
	"strconv"

	"github.com/sruckh/timbre/internal/jobs"
	"github.com/sruckh/timbre/internal/voices"
)

// statusBadgeClass colors a queue row's badge from the palette's render-state
// axis: Teal is queued, Amber is work that resolves on its own (warming the
// GPU, rendering), Green is ready, Burnt is failed. Color is the second
// signal — the word always carries the meaning.
func statusBadgeClass(status string) string {
	switch status {
	case jobs.StatusReady:
		return "badge--ready"
	case jobs.StatusFailed:
		return "badge--limit"
	case jobs.StatusSubmitted, jobs.StatusInProgress:
		return "badge--working"
	default:
		return "badge--queued"
	}
}

// statusLabel is the human wording for a job status. A submitted job is still
// waiting on a warm worker — "Warming GPU" — which DESIGN.md names as its own
// state rather than a disguised spinner.
func statusLabel(status string) string {
	switch status {
	case jobs.StatusQueued:
		return "Queued"
	case jobs.StatusSubmitted:
		return "Warming GPU"
	case jobs.StatusInProgress:
		return "Rendering"
	case jobs.StatusReady:
		return "Ready"
	case jobs.StatusFailed:
		return "Failed"
	default:
		return status
	}
}

// excerpt trims a script down to a single scannable line.
func excerpt(text string) string {
	const limit = 110
	runes := []rune(text)
	if len(runes) <= limit {
		return text
	}
	return string(runes[:limit]) + "…"
}

// voiceLabel names the job's voice, tolerating one deleted after the job ran.
func voiceLabel(j jobs.Job) string {
	if j.VoiceName == "" {
		return "Voice removed"
	}
	if j.VoiceKind == voices.KindCloned {
		return j.VoiceName + " · cloned"
	}
	return j.VoiceName
}

// lengthLabel is the take's audio length ("0:06.02") once rendered, computed
// from the saved WAV by the handler; anything not ready reports a dash.
func lengthLabel(j jobs.Job, durations map[int64]string) string {
	if j.Status == jobs.StatusReady {
		if d := durations[j.ID]; d != "" {
			return d
		}
	}
	return "—"
}

// gpuLabel reports what the render cost in GPU seconds.
func gpuLabel(j jobs.Job) string {
	if j.ExecMS > 0 {
		return strconv.FormatFloat(float64(j.ExecMS)/1000, 'f', 1, 64) + " s"
	}
	return "—"
}

// ariaSelected returns the aria-selected attribute value for a queue row, so a
// single attribute (plus .is-selected) carries "this take is in the player".
func ariaSelected(selected bool) string {
	if selected {
		return "true"
	}
	return "false"
}

// queuePollURL is the address the queue polls itself at. Carrying the selected
// take in the URL — rather than in a client-side value the poll has to attach —
// is what makes the highlight self-sustaining: the server renders the selection,
// the rendered fragment asks for it again on the next tick, and a swap can never
// land without it.
func queuePollURL(selected int64) string {
	if selected > 0 {
		return "/jobs?take=" + strconv.FormatInt(selected, 10)
	}
	return "/jobs"
}

// Queue is the swap target: the whole queue, returned by both GET /jobs and
// POST /jobs so HTMX can refresh it in place. Its root carries id="queue" and
// polls every 2s — the browser never talks to RunPod, only to this fragment.
//
// justQueued is the id of a job enqueued by the request being answered; it
// drives the "enqueue succeeded" message. Pass 0 when nothing was just added.
//
// selected is the take currently in the player. It is carried in the poll's own
// URL (`/jobs?take=N`), so each swap re-renders the highlight and the next poll
// asks for it again — the selection sustains itself with no client state in the
// loop. The player itself lives outside this fragment and is never swapped by
// the poll — otherwise playback would restart on the tick.
templ Queue(items []jobs.Job, justQueued int64, durations map[int64]string, selected int64) {
	<div
		id="queue"
		hx-get={ queuePollURL(selected) }
		hx-trigger="every 2s"
		hx-swap="outerHTML show:none"
		hx-on::before-swap="const el = this.querySelector('.scrollable-list'); window._queueScrollTop = el ? el.scrollTop : 0;"
		hx-on::after-swap="const el = this.querySelector('.scrollable-list'); if (el &amp;&amp; window._queueScrollTop !== undefined) el.scrollTop = window._queueScrollTop;"
		data-take={ strconv.FormatInt(selected, 10) }
		class="flex flex-col gap-3"
	>
		if justQueued > 0 {
			<div class="alert alert--ready" role="status">
				<div>
					<b>Enqueue succeeded</b>
					<p>Job { strconv.FormatInt(justQueued, 10) } queued — the worker picks it up within a couple of seconds.</p>
				</div>
			</div>
		}
		if len(items) == 0 {
			<div class="empty">
				<span class="badge badge--live"><span class="dot"></span> Nothing rendered yet</span>
				<h4>The queue is quiet</h4>
				<p>Write a script, pick a voice, and render your first take — it lands here.</p>
			</div>
		} else {
			<div class="rounded-container border border-line bg-surface-1 p-4 scrollable-list max-h-[500px]">
				<table class="queue-table w-full table-fixed" role="grid">
					<thead>
						<tr>
							<th class="w-[25%]">Take</th>
							<th class="w-[18%]">Voice</th>
							<th class="w-[16%]">State</th>
							<th class="w-[12%]">Length</th>
							<th class="w-[13%]">GPU</th>
							<th class="w-[16%]"><span class="sr-only">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						for _, j := range items {
							@queueRow(j, durations, j.ID == selected)
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

// queueRow is one job: take, voice, state badge, length and GPU cost. The whole
// row is the target — clicking (or Enter/Space on) it loads that take into the
// player and marks the row selected. A ready job carries an icon-only download
// control; a failed job shows the recorded reason in Burnt — the only place the
// user learns why.
//
// The row controls stop click propagation: downloading or deleting a take is
// not a request to play it.
templ queueRow(j jobs.Job, durations map[int64]string, selected bool) {
	<tr
		id={ "job-" + strconv.FormatInt(j.ID, 10) }
		class={ "queue-row", templ.KV("is-selected", selected) }
		aria-selected={ ariaSelected(selected) }
		tabindex="0"
		data-take={ strconv.FormatInt(j.ID, 10) }
		hx-get={ "/jobs/" + strconv.FormatInt(j.ID, 10) + "/player" }
		hx-target="#playback-body"
		hx-swap="innerHTML"
		hx-trigger="click, keyup[key=='Enter'], keyup[key==' ']"
	>
		<td>
			<div class="flex flex-wrap items-center gap-2">
				<span class="font-display text-[14px] font-semibold tracking-[-0.01em]">Take { strconv.FormatInt(j.ID, 10) }</span>
				<span class="badge badge--selected queue-mark"><span class="dot"></span> In the player</span>
			</div>
			<div class="mt-0.5 text-[12px] break-words text-text-dim">{ excerpt(j.Text) }</div>
			if j.Status == jobs.StatusFailed && j.Error != "" {
				<div class="mt-1 font-mono text-[11px] break-words text-burnt">{ j.Error }</div>
			}
		</td>
		<td class="break-words text-text-dim">{ voiceLabel(j) }</td>
		<td>
			<span class={ "badge", statusBadgeClass(j.Status) }>
				<span class="dot"></span>
				{ statusLabel(j.Status) }
			</span>
		</td>
		<td class="num">{ lengthLabel(j, durations) }</td>
		<td class="num">{ gpuLabel(j) }</td>
		<td>
			<div class="flex items-center justify-end gap-1">
				if j.Status == jobs.StatusReady {
					<a
						href={ templ.SafeURL("/jobs/" + strconv.FormatInt(j.ID, 10) + "/audio") }
						download
						onclick="event.stopPropagation()"
						class="btn btn--quiet btn--sm btn--icon"
						aria-label={ "Download take " + strconv.FormatInt(j.ID, 10) + " as WAV" }
						title={ "Download take " + strconv.FormatInt(j.ID, 10) + " as WAV" }
					>
						@iconDownload()
					</a>
				}
				<button
					type="button"
					hx-delete={ "/jobs/" + strconv.FormatInt(j.ID, 10) }
					hx-target="#queue"
					hx-swap="outerHTML"
					hx-confirm={ "Delete take " + strconv.FormatInt(j.ID, 10) + "? The WAV goes with it." }
					onclick="event.stopPropagation()"
					class="btn btn--danger btn--sm btn--icon"
					aria-label={ "Delete take " + strconv.FormatInt(j.ID, 10) }
					title={ "Delete take " + strconv.FormatInt(j.ID, 10) }
				>
					@iconTrash()
				</button>
			</div>
		</td>
	</tr>
}

// iconDownload / iconTrash are the queue's two row actions. They carry no text:
// the accessible name lives on the control's aria-label, which is what buys the
// table back the width it was scrolling to find.
templ iconDownload() {
	<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M8 2.5v7"></path>
		<path d="M4.75 6.25 8 9.5l3.25-3.25"></path>
		<path d="M2.75 12.75h10.5"></path>
	</svg>
}

templ iconTrash() {
	<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M2.75 4.25h10.5"></path>
		<path d="M6.5 4.25V2.75h3v1.5"></path>
		<path d="M4.25 4.25 5 13.25h6l.75-9"></path>
	</svg>
}

// QueuePage is the standalone queue view: the same compose card as the studio,
// the live queue table, and the player the selected row lands in.
templ QueuePage(items []jobs.Job, available []voices.Voice, durations map[int64]string, selected int64) {
	{{ take := resolveSelected(items, selected) }}
	@AppShell("Queue · Timbre", "queue") {
		<header class="pb-8">
			<p class="eyebrow">Render queue</p>
			<h1 class="font-display text-[26px] font-semibold tracking-[-0.02em]">Queue a render</h1>
			<p class="mt-2 max-w-[62ch] text-text-dim">
				Queued jobs are submitted to the synthesizer by a background worker — nothing
				here waits on the render, so a long job never ties up the page.
			</p>
		</header>
		@Compose(available, firstVoiceID(available))
		<section class="mt-8">
			@Queue(items, 0, durations, take)
		</section>
		@playbackSection(items, durations, take)
		@studioHelpers(take)
	}
}
