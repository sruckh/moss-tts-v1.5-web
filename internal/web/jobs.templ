package web

import (
	"strconv"

	"github.com/sruckh/timbre/internal/jobs"
	"github.com/sruckh/timbre/internal/voices"
)

// statusBadgeClass colors a queue row's badge from the palette's render-state
// axis: Teal is queued, Amber is work that resolves on its own (warming the
// GPU, rendering), Green is ready, Burnt is failed. Color is the second
// signal — the word always carries the meaning.
func statusBadgeClass(status string) string {
	switch status {
	case jobs.StatusReady:
		return "badge--ready"
	case jobs.StatusFailed:
		return "badge--limit"
	case jobs.StatusSubmitted, jobs.StatusInProgress:
		return "badge--working"
	default:
		return "badge--queued"
	}
}

// statusLabel is the human wording for a job status. A submitted job is still
// waiting on a warm worker — "Warming GPU" — which DESIGN.md names as its own
// state rather than a disguised spinner.
func statusLabel(status string) string {
	switch status {
	case jobs.StatusQueued:
		return "Queued"
	case jobs.StatusSubmitted:
		return "Warming GPU"
	case jobs.StatusInProgress:
		return "Rendering"
	case jobs.StatusReady:
		return "Ready"
	case jobs.StatusFailed:
		return "Failed"
	default:
		return status
	}
}

// excerpt trims a script down to a single scannable line.
func excerpt(text string) string {
	const limit = 110
	runes := []rune(text)
	if len(runes) <= limit {
		return text
	}
	return string(runes[:limit]) + "…"
}

// voiceLabel names the job's voice, tolerating one deleted after the job ran.
func voiceLabel(j jobs.Job) string {
	if j.VoiceName == "" {
		return "Voice removed"
	}
	if j.VoiceKind == voices.KindCloned {
		return j.VoiceName + " · cloned"
	}
	return j.VoiceName
}

// lengthLabel is the take's audio length ("0:06.02") once rendered, computed
// from the saved WAV by the handler; anything not ready reports a dash.
func lengthLabel(j jobs.Job, durations map[int64]string) string {
	if j.Status == jobs.StatusReady {
		if d := durations[j.ID]; d != "" {
			return d
		}
	}
	return "—"
}

// gpuLabel reports what the render cost in GPU seconds.
func gpuLabel(j jobs.Job) string {
	if j.ExecMS > 0 {
		return strconv.FormatFloat(float64(j.ExecMS)/1000, 'f', 1, 64) + " s"
	}
	return "—"
}

// Queue is the swap target: the whole queue, returned by both GET /jobs and
// POST /jobs so HTMX can refresh it in place. Its root carries id="queue" and
// polls every 2s — the browser never talks to RunPod, only to this fragment.
//
// justQueued is the id of a job enqueued by the request being answered; it
// drives the "enqueue succeeded" message. Pass 0 when nothing was just added.
templ Queue(items []jobs.Job, justQueued int64, durations map[int64]string) {
	<div
		id="queue"
		hx-get="/jobs"
		hx-trigger="every 2s"
		hx-swap="outerHTML"
		class="flex flex-col gap-3"
	>
		if justQueued > 0 {
			<div class="alert alert--ready" role="status">
				<div>
					<b>Enqueue succeeded</b>
					<p>Job { strconv.FormatInt(justQueued, 10) } queued — the worker picks it up within a couple of seconds.</p>
				</div>
			</div>
		}
		if len(items) == 0 {
			<div class="empty">
				<span class="badge badge--live"><span class="dot"></span> Nothing rendered yet</span>
				<h4>The queue is quiet</h4>
				<p>Write a script, pick a voice, and render your first take — it lands here.</p>
			</div>
		} else {
			<div class="overflow-x-auto rounded-container border border-line bg-surface-1 p-4">
				<table class="queue-table">
					<thead>
						<tr>
							<th>Take</th>
							<th>Voice</th>
							<th>State</th>
							<th>Length</th>
							<th>GPU</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, j := range items {
							@queueRow(j, durations)
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

// queueRow is one job: take, voice, state badge, length and GPU cost. A ready
// job carries its Download WAV control; a failed job shows the recorded reason
// in Burnt — the only place the user learns why.
templ queueRow(j jobs.Job, durations map[int64]string) {
	<tr id={ "job-" + strconv.FormatInt(j.ID, 10) }>
		<td class="max-w-[36ch]">
			<div class="font-display text-[14px] font-semibold tracking-[-0.01em]">Take { strconv.FormatInt(j.ID, 10) }</div>
			<div class="mt-0.5 truncate text-[12px] text-text-dim">{ excerpt(j.Text) }</div>
			if j.Status == jobs.StatusFailed && j.Error != "" {
				<div class="mt-1 font-mono text-[11px] text-burnt">{ j.Error }</div>
			}
		</td>
		<td class="text-text-dim">{ voiceLabel(j) }</td>
		<td>
			<span class={ "badge", statusBadgeClass(j.Status) }>
				<span class="dot"></span>
				{ statusLabel(j.Status) }
			</span>
		</td>
		<td class="num">{ lengthLabel(j, durations) }</td>
		<td class="num">{ gpuLabel(j) }</td>
		<td class="whitespace-nowrap">
			<div class="flex items-center gap-2">
				if j.Status == jobs.StatusReady {
					<a
						href={ templ.SafeURL("/jobs/" + strconv.FormatInt(j.ID, 10) + "/audio") }
						download
						class="btn btn--quiet btn--sm"
					>Download WAV</a>
				}
				<button
					type="button"
					hx-delete={ "/jobs/" + strconv.FormatInt(j.ID, 10) }
					hx-target="#queue"
					hx-swap="outerHTML"
					hx-confirm={ "Delete take " + strconv.FormatInt(j.ID, 10) + "? The WAV goes with it." }
					class="btn btn--danger btn--sm"
				>Delete</button>
			</div>
		</td>
	</tr>
}

// QueuePage is the standalone queue view: the same compose card as the studio
// plus the live queue table.
templ QueuePage(items []jobs.Job, available []voices.Voice, durations map[int64]string) {
	@AppShell("Queue · Timbre", "queue") {
		<header class="pb-8">
			<p class="eyebrow">Render queue</p>
			<h1 class="font-display text-[26px] font-semibold tracking-[-0.02em]">Queue a render</h1>
			<p class="mt-2 max-w-[62ch] text-text-dim">
				Queued jobs are submitted to the synthesizer by a background worker — nothing
				here waits on the render, so a long job never ties up the page.
			</p>
		</header>
		@Compose(available, firstVoiceID(available))
		<section class="mt-8">
			@Queue(items, 0, durations)
		</section>
		@studioHelpers()
	}
}
