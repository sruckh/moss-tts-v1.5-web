package web

import (
	"math"
	"strconv"

	"github.com/sruckh/timbre/internal/voices"
)

// firstVoiceID is the card selected on first paint: the first (oldest) voice,
// which is a stock model once the startup seed has run. 0 means "nothing to
// select" (empty library).
func firstVoiceID(items []voices.Voice) int64 {
	if len(items) == 0 {
		return 0
	}
	return items[0].ID
}

// voiceModelLine is the secondary line under the name: "model · license" for
// stock voices, a plain "Cloned" label for uploaded references.
func voiceModelLine(v voices.Voice) string {
	if v.Kind == voices.KindCloned {
		return "Cloned"
	}
	if v.LicenseLabel != "" {
		return v.Model + " · " + v.LicenseLabel
	}
	return v.Model
}

// badgeClasses / badgeLabel render the license badge. Every seeded stock voice
// is commercial-safe (MIT / Apache-2.0); an uploaded reference is a cloned
// voice. Color is the second signal — the word always carries the meaning.
func badgeClasses(v voices.Voice) string {
	if v.Kind == voices.KindCloned {
		return "bg-purple/22 text-paper border-purple/60"
	}
	return "bg-green/16 text-green border-green/45"
}

func badgeLabel(v voices.Voice) string {
	if v.Kind == voices.KindCloned {
		return "Cloned voice"
	}
	return "Commercial-safe"
}

// ariaPressed returns the aria-pressed attribute value so a single attribute
// flip in the browser restyles a selected card (see .voice-card CSS).
func ariaPressed(selected bool) string {
	if selected {
		return "true"
	}
	return "false"
}

// miniWaveHeights returns 26 deterministic bar heights (px) for the Teal
// fingerprint. The phase (voice id) varies the shape per card.
func miniWaveHeights(phase int) []float64 {
	out := make([]float64, 26)
	for i := range out {
		out[i] = 5 + math.Abs(math.Sin(float64(i+phase*3)*0.9))*20
	}
	return out
}

// VoiceLibrary is the full voice-library page: header, the upload affordance,
// and the grid of voice cards.
templ VoiceLibrary(items []voices.Voice) {
	@Layout("Voice library · Timbre") {
		<main class="mx-auto max-w-5xl p-8">
			<header class="mb-6">
				<p class="font-mono text-[11px] uppercase tracking-[0.14em] text-text-dim">Voice library</p>
				<h1 class="mt-1 font-display text-3xl font-extrabold tracking-[-0.02em] text-paper">Pick or clone a voice</h1>
				<p class="mt-2 max-w-2xl text-text-dim">
					Stock models ship commercial-safe. Upload a short, clean reference to clone a voice —
					it is stored privately and delivered to the synthesizer inline. The whole card is the target.
				</p>
			</header>
			@uploadAffordance()
			<section class="mt-6">
				<h2 class="mb-3 font-mono text-[11px] uppercase tracking-[0.14em] text-text-dim">Voices</h2>
				@VoiceGrid(items, firstVoiceID(items))
			</section>
		</main>
		<script>
			// Click a card to select it: flip aria-pressed and let the CSS restyle.
			// Delegated to document so the handler survives the grid swap after an upload.
			document.addEventListener('click', function (e) {
				var btn = e.target.closest('.voice-card');
				if (!btn) { return; }
				var grid = btn.closest('#voice-grid');
				if (!grid) { return; }
				grid.querySelectorAll('.voice-card').forEach(function (b) {
					b.setAttribute('aria-pressed', 'false');
				});
				btn.setAttribute('aria-pressed', 'true');
			});
		</script>
	}
}

// VoiceGrid is the swap target: a full-grid fragment returned both by the page
// and by the upload handler (so HTMX can refresh it in place). Its root carries
// id="voice-grid".
templ VoiceGrid(items []voices.Voice, selectedID int64) {
	<div id="voice-grid" class="grid gap-4 sm:grid-cols-2">
		if len(items) == 0 {
			<p class="col-span-full rounded-container border border-line bg-surface-1 p-4 text-text-dim">
				No voices yet. Upload a reference to add one.
			</p>
		} else {
			for _, v := range items {
				@voiceCard(v, v.ID == selectedID)
			}
		}
	</div>
}

// voiceCard is one selectable voice: name, model · license, a Teal fingerprint,
// and a license badge. The whole card is a button — selection is an aria-pressed
// state styled by .voice-card in the stylesheet (Indigo border + 12% wash).
templ voiceCard(v voices.Voice, selected bool) {
	<button
		type="button"
		aria-pressed={ ariaPressed(selected) }
		class="voice-card flex cursor-pointer flex-col gap-3 rounded-container border border-line bg-surface-1 p-4 text-left transition-colors hover:border-line-loud"
	>
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<div class="font-display text-[17px] font-semibold tracking-[-0.015em] text-paper">{ v.Name }</div>
				<div class="mt-0.5 font-mono text-[11px] text-text-dim">{ voiceModelLine(v) }</div>
			</div>
			<span class={ "inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2 py-[3px] font-mono text-[10.5px] uppercase tracking-[0.07em]", badgeClasses(v) }>
				{ badgeLabel(v) }
			</span>
		</div>
		<div class="flex h-[26px] items-center gap-0.5" aria-hidden="true">
			for _, h := range miniWaveHeights(int(v.ID)) {
				<span class="block w-[3px] rounded-full bg-teal" style={ "height: " + strconv.FormatFloat(h, 'f', 1, 64) + "px" }></span>
			}
		</div>
	</button>
}

// uploadAffordance is the drag/drop + click-to-pick target. A hidden file input
// does the work: picking (or dropping) a file fires its change event, and HTMX
// posts the multipart body to /voices/upload, swapping in the refreshed grid.
templ uploadAffordance() {
	<form id="voice-upload" class="voice-drop flex flex-col items-center justify-center gap-1 rounded-container border border-dashed border-line bg-surface-1 p-6 text-center">
		<input
			type="file"
			id="voice-file"
			name="reference"
			accept="audio/*"
			class="hidden"
			hx-post="/voices/upload"
			hx-trigger="change"
			hx-encoding="multipart/form-data"
			hx-target="#voice-grid"
			hx-swap="outerHTML"
		/>
		<label for="voice-file" class="flex cursor-pointer flex-col items-center gap-1">
			<span class="font-display text-lg font-semibold text-paper">Drop a reference audio file</span>
			<span class="text-text-dim">or click to choose one — WAV, MP3, FLAC, OGG · up to 10 MB</span>
		</label>
	</form>
	<script>
		(function () {
			var form = document.getElementById('voice-upload');
			if (!form) { return; }
			var input = document.getElementById('voice-file');
			['dragenter', 'dragover'].forEach(function (ev) {
				form.addEventListener(ev, function (e) {
					e.preventDefault();
					form.classList.add('voice-drop--over');
				});
			});
			['dragleave', 'drop'].forEach(function (ev) {
				form.addEventListener(ev, function (e) {
					e.preventDefault();
					form.classList.remove('voice-drop--over');
				});
			});
			form.addEventListener('drop', function (e) {
				if (!e.dataTransfer || !e.dataTransfer.files || !e.dataTransfer.files.length) { return; }
				input.files = e.dataTransfer.files;
				input.dispatchEvent(new Event('change', { bubbles: true }));
			});
		})();
	</script>
}
