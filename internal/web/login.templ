package web

// Login is the gated app's front door: a single centered card on the ink
// canvas. It posts as a plain form (no JS required); the handlers answer 200
// with LoginSuccess on good credentials and re-render this page with an error
// on bad ones.
templ Login(errMsg string) {
	@Layout("Sign in · Timbre") {
		<main class="flex min-h-screen items-center justify-center p-6">
			<div class="w-full max-w-sm rounded-container border border-line bg-surface-1 p-8">
				<div class="mb-4 flex items-center gap-2 font-display text-[19px] font-extrabold tracking-[-0.02em]">
					<span class="h-[9px] w-[9px] rounded-full bg-olive"></span>
					Timbre
				</div>
				<p class="text-sm text-text-dim">Sign in to continue.</p>
				if errMsg != "" {
					<div class="alert alert--limit mt-4" role="alert">
						<div><b>Sign-in failed</b><p>{ errMsg }</p></div>
					</div>
				}
				<form method="post" action="/login" class="mt-6 flex flex-col gap-4">
					<div>
						<label for="username" class="field-label">Username</label>
						<input
							id="username"
							name="username"
							type="text"
							required
							autofocus
							autocomplete="username"
							class="input"
						/>
					</div>
					<div>
						<label for="password" class="field-label">Password</label>
						<input
							id="password"
							name="password"
							type="password"
							required
							autocomplete="current-password"
							class="input"
						/>
					</div>
					<button type="submit" class="btn w-full justify-center">
						Sign in
					</button>
				</form>
				<p class="mt-6 text-[12.5px] text-text-dim">
					No account? <a href="/apply" class="text-olive underline">Request access</a>.
					<br/>
					Applied already? <a href="/apply/status" class="text-olive underline">Check its status</a>.
				</p>
			</div>
		</main>
	}
}

// LoginSuccess answers a successful POST /login with 200 (the session cookie
// is already set) and moves the browser to the app: HX-Redirect covers HTMX
// callers, the script covers everyone with JS, and the link is the no-JS
// fallback.
templ LoginSuccess() {
	@Layout("Signed in · Timbre") {
		<main class="flex min-h-screen items-center justify-center p-6">
			<p class="text-paper">
				Signed in. <a href="/" class="text-olive underline">Continue to Timbre</a>.
			</p>
			<script>window.location.replace("/");</script>
		</main>
	}
}
