# Copy to .env and fill in. Docker Compose loads .env automatically.
# .env is git-ignored — deployment values and secrets never belong in the repo.

# The externally reachable hostname this app answers on, behind Cloudflare and
# NGINX Proxy Manager. Reference-audio URLs are built from it, and RunPod's
# workers fetch those URLs themselves, so it must NOT be an internal address.
TIMBRE_PUBLIC_BASE_URL=https://timbre.example.com

# Your RunPod serverless endpoint for MossTTS v1.5.
RUNPOD_ENDPOINT=https://api.runpod.ai/v2/your-endpoint-id

# How many renders the worker keeps in flight at once.
TIMBRE_MAX_IN_FLIGHT=2

# Infisical machine identity. RUNPOD_API_KEY and the replication credentials are
# pulled from Infisical at container start, so they never appear here or in the
# repo. scripts/env.sh can export these from an encrypted store outside the repo.
INFISICAL_HOST=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=prod
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# Region for the S3-compatible replication target.
S3_REGION=
